const BULK_RULES_SHEET='Regles_categories';
const BULK_RULES_HEADERS=['id','motif','categorie','type','actif','cree_le','modifie_le'];
function initialiserReglesCategories_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let f=ss.getSheetByName(BULK_RULES_SHEET);if(!f)f=ss.insertSheet(BULK_RULES_SHEET);if(f.getLastRow()===0)f.getRange(1,1,1,BULK_RULES_HEADERS.length).setValues([BULK_RULES_HEADERS]);f.setFrozenRows(1);return f;}
function lireReglesCategories(){const f=initialiserReglesCategories_();if(f.getLastRow()<2)return[];return f.getRange(2,1,f.getLastRow()-1,BULK_RULES_HEADERS.length).getValues().map(r=>Object.fromEntries(BULK_RULES_HEADERS.map((h,i)=>[h,r[i] instanceof Date?r[i].toISOString():r[i]]))).filter(x=>String(x.actif).toLowerCase()!=='false');}
function texteOperationRegle_(o){const source=typeof sourceAudit_==='function'?sourceAudit_(o):null;return normaliserTexteBanque_([source?.libelle||'',source?.details||'',o.libelle||''].join(' '));}
function analyserRegleCategorie(payload){const motifs=String(payload?.motifs||'').split(/[\n,;]+/).map(x=>normaliserTexteBanque_(x)).filter(x=>x.length>=2),type=String(payload?.type||'depense').toLowerCase();if(!motifs.length)throw new Error('Saisissez au moins un libellé ou mot-clé.');const ops=lireTable_('Operations').filter(o=>String(o.type||'').toLowerCase()===type&&!String(o.commentaire||'').includes('[RECURRENCE:'));const matches=ops.filter(o=>{const t=texteOperationRegle_(o);return motifs.some(m=>t.includes(m));});return{motifs:motifs,total:matches.length,sansCategorie:matches.filter(o=>!String(o.categorie||'').trim()).length,dejaCategoriees:matches.filter(o=>String(o.categorie||'').trim()).length,exemples:matches.slice(0,20).map(o=>({id:o.id,date:o.date,libelle:o.libelle,categorie:o.categorie||'',montant:o.montant,compte:o.compte||''}))};}
function appliquerRegleCategorie(payload){verifierInitialisation_();const categorie=String(payload?.categorie||'').trim(),type=String(payload?.type||'depense').toLowerCase(),motifsBruts=String(payload?.motifs||'').split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean),motifs=motifsBruts.map(normaliserTexteBanque_).filter(x=>x.length>=2),ecraser=payload?.ecraser===true||String(payload?.ecraser)==='true';if(!categorie)throw new Error('Choisissez une catégorie.');if(!motifs.length)throw new Error('Saisissez au moins un libellé ou mot-clé.');const ops=lireTable_('Operations');let trouvees=0,modifiees=0,ignorees=0;ops.forEach(o=>{if(String(o.type||'').toLowerCase()!==type||String(o.commentaire||'').includes('[RECURRENCE:'))return;const t=texteOperationRegle_(o);if(!motifs.some(m=>t.includes(m)))return;trouvees++;if(String(o.categorie||'').trim()&&!ecraser){ignorees++;return;}enregistrerLigne('Operations',{id:o.id,date:o.date,libelle:o.libelle,categorie,compte:o.compte,montant:Math.abs(Number(o.montant||0)),type:o.type,commentaire:o.commentaire||'',cree_le:o.cree_le||''});modifiees++;});const f=initialiserReglesCategories_(),now=new Date().toISOString();motifsBruts.forEach(m=>f.appendRow([Utilities.getUuid(),m,categorie,type,true,now,now]));return{trouvees,modifiees,ignorees,categorie};}
