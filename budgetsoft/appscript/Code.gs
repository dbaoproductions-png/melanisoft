const SHEETS={Parametres:['Cle','Valeur'],Comptes:['Nom','Solde','Type','Actif'],Operations:['Date','Libelle','Categorie','Compte','Montant','Commentaire'],Budget:['Type','Poste','Prevu','Reel'],Actifs:['Nom','Montant'],Dettes:['Nom','Montant'],Credits:['Nom','Mensualite'],Objectifs:['Nom','Montant'],Categories:['Nom']};
function doGet(){return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('BudgetSoft').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL).addMetaTag('viewport','width=device-width, initial-scale=1');}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function onOpen(){SpreadsheetApp.getUi().createMenu('BudgetSoft').addItem('Initialiser le classeur','setupBudgetSoft').addToUi();}
function setupBudgetSoft(){const ss=SpreadsheetApp.getActive();Object.entries(SHEETS).forEach(([name,headers])=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold');sh.setFrozenRows(1);sh.autoResizeColumns(1,headers.length);}});const p=ss.getSheetByName('Parametres');if(p.getLastRow()===1)p.getRange(2,1,2,2).setValues([['Mois',Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM')],['Version','0.1']]);return 'BudgetSoft initialisé';}
function rows(name){const sh=SpreadsheetApp.getActive().getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];return sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues();}
function getBudgetData(){setupBudgetSoft();const params=Object.fromEntries(rows('Parametres').map(r=>[r[0],r[1]]));return{month:String(params.Mois||Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM')),accounts:rows('Comptes').map(r=>[r[0],Number(r[1])||0]),operations:rows('Operations').map(r=>({date:r[0] instanceof Date?Utilities.formatDate(r[0],Session.getScriptTimeZone(),'yyyy-MM-dd'):String(r[0]||''),label:r[1]||'',category:r[2]||'',account:r[3]||'',amount:Number(r[4])||0,note:r[5]||''})),budget:rows('Budget').map(r=>[r[0],r[1],Number(r[2])||0,Number(r[3])||0]),incomes:rows('Budget').filter(r=>r[0]==='Revenu').map(r=>[r[1],Number(r[2])||0]),assets:rows('Actifs').map(r=>[r[0],Number(r[1])||0]),debts:rows('Dettes').map(r=>[r[0],Number(r[1])||0]),credits:rows('Credits').map(r=>[r[0],Number(r[1])||0]),goals:rows('Objectifs').map(r=>[r[0],Number(r[1])||0]),categories:rows('Categories').map(r=>r[0]).filter(Boolean)};}
function write(name,values){const sh=SpreadsheetApp.getActive().getSheetByName(name);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).clearContent();if(values.length)sh.getRange(2,1,values.length,values[0].length).setValues(values);}
function saveBudgetData(d){const lock=LockService.getDocumentLock();lock.waitLock(10000);try{write('Comptes',(d.accounts||[]).map(r=>[r[0],r[1],'',true]));write('Operations',(d.operations||[]).map(r=>[r.date,r.label,r.category,r.account,r.amount,r.note||'']));write('Budget',(d.budget||[]).map(r=>[r[0],r[1],r[2],r[3]]));write('Actifs',d.assets||[]);write('Dettes',d.debts||[]);write('Credits',d.credits||[]);write('Objectifs',d.goals||[]);write('Categories',(d.categories||[]).map(x=>[x]));const p=SpreadsheetApp.getActive().getSheetByName('Parametres');const vals=rows('Parametres');const i=vals.findIndex(r=>r[0]==='Mois');if(i>=0)p.getRange(i+2,2).setValue(d.month);else p.appendRow(['Mois',d.month]);return{ok:true,savedAt:new Date().toISOString()};}finally{lock.releaseLock();}}