const RETRO_AUDIT_SHEET = 'Corrections_a_valider';
const RETRO_AUDIT_HEADERS = ['id','operation_id','statut','raison','confiance','libelle_actuel','libelle_propose','categorie_actuelle','categorie_proposee','type_actuel','type_propose','compte','date_operation','montant','decision','cree_le','modifie_le'];
function initialiserAuditRetro_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let f=ss.getSheetByName(RETRO_AUDIT_SHEET);if(!f)f=ss.insertSheet(RETRO_AUDIT_SHEET);if(f.getLastRow()===0)f.getRange(1,1,1,RETRO_AUDIT_HEADERS.length).setValues([RETRO_AUDIT_HEADERS]);f.setFrozenRows(1);f.getRange(1,1,1,RETRO_AUDIT_HEADERS.length).setFontWeight('bold').setBackground('#147d64').setFontColor('#fff');return f;}
function sourceAudit_(op){const c=String(op.commentaire||'').trim(),fallback=String(op.libelle||'').trim();let bloc='';const m=c.match(/Libellé bancaire\s*:\s*(.*?)(?=\s+\[(?:PDF:HELLOBANK|CARTE_DIFFEREE|CORRESPONDANCE|RAPPROCHEMENT|RAPPROCHEMENT_MANUEL|AUDIT_RETRO|RECURRENCE):|$)/i);if(m)bloc=m[1].trim();else bloc=fallback;if(!bloc)return{libelle:fallback,details:'',references:'',composite:false};const tokens=[' id emetteur/',' mdt/',' ref/',' lib/',' id créancier/',' id creancier/',' mandat/',' reference/',' référence/'];let pos=-1;tokens.forEach(t=>{const p=bloc.toLowerCase().indexOf(t);if(p>=0&&(pos<0||p<pos))pos=p;});let libelle=pos>=0?bloc.slice(0,pos).trim():bloc,details=pos>=0?bloc.slice(pos).trim():'';const marqueDetails=c.match(/(?:^|\s)(Date achat\s*:.*?)(?=\s+\[(?:PDF:HELLOBANK|CARTE_DIFFEREE|CORRESPONDANCE|RAPPROCHEMENT|AUDIT_RETRO|RECURRENCE):|$)/i);if(marqueDetails)details=[details,marqueDetails[1]].filter(Boolean).join(' · ');const refs=(c.match(/\[[A-Z_]+:[^\]]+\]/g)||[]).join(' ');const composite=pos>=0||(/\b(?:id emetteur|mdt|ref|lib)\//i.test(bloc)&&bloc.length>libelle.length+5);return{libelle:libelle||fallback,details,references:refs,composite};}
function brutAudit_(op){return sourceAudit_(op).libelle;}
function lireAuditRetro(){const f=initialiserAuditRetro_();if(f.getLastRow()<2)return [];const audits=f.getRange(2,1,f.getLastRow()-1,RETRO_AUDIT_HEADERS.length).getValues().filter(r=>r.some(v=>v!==''&&v!==null)).map(r=>Object.fromEntries(RETRO_AUDIT_HEADERS.map((h,i)=>[h,r[i] instanceof Date?r[i].toISOString():r[i]]))),ops=Object.fromEntries(lireTable_('Operations').map(o=>[String(o.id),o]));return audits.map(a=>{const op=ops[String(a.operation_id)];const s=op?sourceAudit_(op):{libelle:String(a.libelle_actuel||''),details:'',references:'',composite:false};a.libelle_bancaire=s.libelle;a.details_bancaires=s.details;a.references_techniques=s.references;a.source_composite=s.composite;return a;});}
function lancerAuditRetro(){verifierInitialisation_();initialiserCorrespondancesBancaires();const f=initialiserAuditRetro_(),operations=lireTable_('Operations').filter(o=>!String(o.commentaire||'').includes('[RECURRENCE:')),correspondances=lireCorrespondancesBancaires(),existants=lireAuditRetro(),deja=new Set(existants.filter(x=>String(x.statut)==='À valider').map(x=>String(x.operation_id))),ajouts=[],maintenant=new Date().toISOString();operations.forEach(o=>{if(deja.has(String(o.id)))return;const brut=brutAudit_(o);if(!brut)return;const corr=trouverCorrespondanceBancaire_(brut,o.compte,correspondances),catAct=String(o.categorie||'').trim(),typeAct=String(o.type||'').trim().toLowerCase(),catRegle=suggererCategorieHelloBank_(brut,typeAct),catProp=String(corr?.categorie||catRegle||'').trim(),typeProp=String(corr?.type||typeAct||'').trim().toLowerCase(),libProp=String(corr?.libelle_normalise||'').trim(),raisons=[];let confiance=0;if(!catAct&&catProp){raisons.push('Catégorie manquante');confiance=Math.max(confiance,corr?95:75);}else if(catAct&&catProp&&normaliserTexteBanque_(catAct)!==normaliserTexteBanque_(catProp)){raisons.push('Catégorie incohérente');confiance=Math.max(confiance,corr?90:65);}if(typeProp&&typeAct&&typeProp!==typeAct){raisons.push('Type incohérent');confiance=Math.max(confiance,corr?95:70);}if(libProp&&normaliserTexteBanque_(libProp)!==normaliserTexteBanque_(o.libelle||'')&&String(o.libelle||'').length>60){raisons.push('Libellé non normalisé');confiance=Math.max(confiance,85);}if(!raisons.length)return;ajouts.push({id:Utilities.getUuid(),operation_id:o.id,statut:'À valider',raison:raisons.join(' · '),confiance,libelle_actuel:o.libelle||'',libelle_propose:libProp||o.libelle||'',categorie_actuelle:catAct,categorie_proposee:catProp||catAct,type_actuel:typeAct,type_propose:typeProp||typeAct,compte:o.compte||'',date_operation:o.date,montant:o.montant,decision:'',cree_le:maintenant,modifie_le:maintenant});});if(ajouts.length)f.getRange(f.getLastRow()+1,1,ajouts.length,RETRO_AUDIT_HEADERS.length).setValues(ajouts.map(x=>RETRO_AUDIT_HEADERS.map(h=>x[h]==null?'':x[h])));return{analysees:operations.length,nouvelles:ajouts.length,aValider:lireAuditRetro().filter(x=>String(x.statut)==='À valider').length};}
function deciderAuditRetro(id,decision,modifications){const choix=String(decision||'').toLowerCase();if(!['appliquer','ignorer'].includes(choix))throw new Error('Décision inconnue.');const f=initialiserAuditRetro_(),liste=lireAuditRetro(),item=liste.find(x=>String(x.id)===String(id));if(!item)throw new Error('Proposition introuvable.');if(String(item.statut)!=='À valider')throw new Error('Cette proposition a déjà été traitée.');const mod=modifications&&typeof modifications==='object'?modifications:{},libelleFinal=String(mod.libelle!==undefined?mod.libelle:item.libelle_propose||'').trim(),categorieFinale=String(mod.categorie!==undefined?mod.categorie:item.categorie_proposee||'').trim(),typeFinal=String(mod.type!==undefined?mod.type:item.type_propose||'').trim().toLowerCase(),propager=mod.propager===true||String(mod.propager)==='true';let nbModifiees=0,motif='';if(choix==='appliquer'){if(!libelleFinal)throw new Error('Le libellé proposé ne peut pas être vide.');if(!['depense','revenu'].includes(typeFinal))throw new Error('Le type doit être Dépense ou Revenu.');const operations=lireTable_('Operations'),op=operations.find(o=>String(o.id)===String(item.operation_id));if(!op)throw new Error('Opération introuvable.');const source=sourceAudit_(op);if(propager&&source.composite)throw new Error('Source bancaire composite : vérifiez les détails avant de propager. Appliquez d’abord à cette opération uniquement.');const brut=source.libelle;motif=extraireMotifStableBanque_(brut);let cibles=[op];if(propager&&motif)cibles=operations.filter(x=>!String(x.commentaire||'').includes('[RECURRENCE:')&&String(x.compte||'')===String(op.compte||'')&&extraireMotifStableBanque_(brutAudit_(x))===motif);cibles.forEach(x=>{enregistrerLigne('Operations',{id:x.id,date:x.date,libelle:libelleFinal,categorie:categorieFinale,compte:x.compte,montant:Math.abs(Number(x.montant||0)),type:typeFinal,commentaire:[x.commentaire||'','[AUDIT_RETRO:'+item.id+']'].filter(Boolean).join(' '),cree_le:x.cree_le||''});nbModifiees++;});if(propager&&motif){const correspondances=lireCorrespondancesBancaires(),existante=correspondances.find(c=>normaliserTexteBanque_(c.motif_bancaire)===motif&&(!c.compte||String(c.compte)===String(op.compte||'')));enregistrerCorrespondanceBancaire({id:existante?.id,motif_bancaire:motif,libelle_normalise:libelleFinal,categorie:categorieFinale,type:typeFinal,compte:op.compte||'',actif:true,utilisations:Number(existante?.utilisations||0)+nbModifiees,cree_le:existante?.cree_le||''});}}const ids=f.getRange(2,1,f.getLastRow()-1,1).getValues().flat(),pos=ids.findIndex(v=>String(v)===String(id)),ligne=pos+2,vals=f.getRange(ligne,1,1,RETRO_AUDIT_HEADERS.length).getValues()[0],obj=Object.fromEntries(RETRO_AUDIT_HEADERS.map((h,i)=>[h,vals[i]]));if(choix==='appliquer'){obj.libelle_propose=libelleFinal;obj.categorie_proposee=categorieFinale;obj.type_propose=typeFinal;}obj.statut=choix==='appliquer'?'Traité':'Ignoré';obj.decision=choix==='appliquer'?(propager?'Correction appliquée à '+nbModifiees+' opération(s) équivalente(s) et règle mémorisée':'Correction appliquée à cette opération uniquement'):'Proposition ignorée';obj.modifie_le=new Date().toISOString();f.getRange(ligne,1,1,RETRO_AUDIT_HEADERS.length).setValues([RETRO_AUDIT_HEADERS.map(h=>obj[h]==null?'':obj[h])]);return{ok:true,modifiees:nbModifiees,propagation:propager,motif,restant:lireAuditRetro().filter(x=>String(x.statut)==='À valider').length};}
